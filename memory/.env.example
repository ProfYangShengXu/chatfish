# Memory Bridge 环境配置模板
#
# 用法：复制成 .env 并填入真实值。.env 已在 .gitignore 里，不会入库。
#   cp .env.example .env
#
# ⚠️ 密码只放这里。不要写进任何 .py，不要提交，不要打印到日志。
#    Config 覆写了 __repr__/__str__ 做掩码，但异常信息仍可能带 conninfo ——
#    汇报与日志里请一律用 config.mask_dsn() 处理过的字符串。

# —— 数据库 ——
# PG 跑在 WSL 里，代码通过 WSL2 的 localhost 转发连 127.0.0.1:5432。
# 这条走的是 host 认证（scram-sha-256），**必须带密码**（local 才是 peer 免密）。
MEMORY_BRIDGE_PG_DSN=host=127.0.0.1 port=5432 dbname=memory_bridge user=memory_bridge password=CHANGE_ME

# —— 路径 ——
# 模型目录（bge-small-zh-v1.5 / bge-reranker-base 放在这里面）
MEMORY_BRIDGE_MODELS_DIR=./models
# 运行期数据（.processed 清单、server.log、bm25 缓存）
MEMORY_BRIDGE_DATA_DIR=./var

# —— 身份与注入目标 ——
# 单用户本机；owner 留着是为了多用户时不用改 schema
MEMORY_BRIDGE_OWNER=user:local
# 记忆区写进哪些上下文文件（os.pathsep 分隔：Linux/WSL 用 ":"，Windows 用 ";"）
MEMORY_BRIDGE_CONTEXT_FILES=./CLAUDE.md

# —— 常驻服务（只绑回环）——
MEMORY_BRIDGE_PORT=8765

# —— 召回 ——
MEMORY_BRIDGE_RERANK_ENABLED=true
MEMORY_BRIDGE_RECALL_K=50
MEMORY_BRIDGE_RECALL_FINAL_K=5
MEMORY_BRIDGE_RERANK_MAX_CANDIDATES=50

# —— 模型下载镜像（国内直连慢；脚本默认也会设这两个值）——
HF_ENDPOINT=https://hf-mirror.com
# 新版 huggingface_hub 默认走 Xet 协议，经镜像下载会 401；必须关掉
HF_HUB_DISABLE_XET=1
